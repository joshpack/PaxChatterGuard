<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PaxChatterGuard.Views.MonitorWindow"
        Title="Chatter Monitor — PAX Chatter Guard"
        Width="580" Height="660" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="22,20,22,16">

    <!-- Header -->
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
      <Border Width="38" Height="38" CornerRadius="10" BoxShadow="0 0 18 0 #6600C8FF, 0 0 30 3 #3319F58C">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#00C8FF" Offset="0" />
            <GradientStop Color="#19F58C" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Viewbox Margin="9">
          <Path x:Name="Spade" Fill="#04140C" Width="100" Height="100" Stretch="Uniform" />
        </Viewbox>
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1">
        <TextBlock Text="Chatter Monitor" FontSize="18" FontWeight="Bold" Classes="neon" />
        <TextBlock x:Name="SinceText" Classes="muted" FontSize="11" />
      </StackPanel>
      <Border x:Name="StatusPill" Grid.Column="2" CornerRadius="999" Padding="11,5" VerticalAlignment="Center"
              Background="#0C2A1D" BorderBrush="#146B44" BorderThickness="1">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#19F58C" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusText" Text="Filtering on" FontWeight="SemiBold" FontSize="12" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Totals -->
    <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="8" Margin="0,0,0,10">
      <Border Classes="stat">
        <StackPanel>
          <TextBlock x:Name="BlockedCount" Text="0" Classes="statnum" Foreground="#19F58C" />
          <TextBlock Text="blocked" Classes="muted" FontSize="11" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="stat">
        <StackPanel>
          <TextBlock x:Name="SlippedCount" Text="0" Classes="statnum" Foreground="#F5B14C" />
          <TextBlock Text="got through" Classes="muted" FontSize="11" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="stat">
        <StackPanel>
          <TextBlock x:Name="NotFilteredCount" Text="0" Classes="statnum" Foreground="#00C8FF" />
          <TextBlock Text="not filtered" Classes="muted" FontSize="11" />
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Classes="stat">
        <StackPanel>
          <TextBlock x:Name="CloseCount" Text="0" Classes="statnum" Foreground="#8A92A6" />
          <TextBlock Text="close calls" Classes="muted" FontSize="11" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Options -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="14" Margin="0,0,0,10">
      <CheckBox x:Name="CloseCallsBox" Content="Close calls" IsChecked="True" />
      <CheckBox x:Name="TopmostBox" Grid.Column="1" Content="Keep on top" />
      <Button x:Name="CopyButton" Grid.Column="3" Content="Copy" Classes="ghost" MinHeight="32" Padding="12,4" />
      <Button x:Name="ClearButton" Grid.Column="4" Content="Clear" MinHeight="32" Padding="14,4" />
    </Grid>

    <!-- The log -->
    <Border Grid.Row="3" Classes="card" Padding="6">
      <ScrollViewer>
        <StackPanel Margin="0,0,8,0">
          <StackPanel x:Name="EventList" Spacing="6" />
          <StackPanel x:Name="EmptyState" Spacing="6" Margin="12,28,12,28" HorizontalAlignment="Center">
            <TextBlock Text="Nothing yet" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380"
                       Text="Type normally and leave this open. Every press that looks like chatter shows up here, blocked or not, with its timing, so you can see what your keyboard is doing." />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <TextBlock x:Name="Footer" Grid.Row="4" Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="2,10,2,0"
               Text="Gap = how soon the key went down again after you let go of it. Held = how long that press lasted; a finger can't do under 15 ms. Add to list gives a key its own delay, just above the gap. Kept in memory only, never saved." />
  </Grid>
</Window>
