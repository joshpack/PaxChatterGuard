<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PaxChatterGuard.Views.SettingsWindow"
        Title="PAX Chatter Guard"
        Width="500" Height="660" MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterScreen">

  <!-- Header, then anything that needs attention, the keyboard being edited, and three tabs. -->
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="22,20,22,16">

    <!-- Header -->
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
      <Border Width="38" Height="38" CornerRadius="10" BoxShadow="0 0 18 0 #6600C8FF, 0 0 30 3 #3319F58C">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#00C8FF" Offset="0" />
            <GradientStop Color="#19F58C" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Viewbox Margin="9">
          <Path x:Name="Spade" Fill="#04140C" Width="100" Height="100" Stretch="Uniform" />
        </Viewbox>
      </Border>
      <TextBlock Grid.Column="1" Text="PAX Chatter Guard" FontSize="18" FontWeight="Bold" Classes="neon"
                 VerticalAlignment="Center" Margin="12,0,0,0" />
      <Border x:Name="StatusPill" Grid.Column="2" CornerRadius="999" Padding="11,5" VerticalAlignment="Center"
              Background="#0C2A1D" BorderBrush="#146B44" BorderThickness="1">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#19F58C" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusText" Text="On" FontWeight="SemiBold" FontSize="12" MaxWidth="230" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Only shown when something needs the user -->
    <StackPanel Grid.Row="1" Spacing="10">
      <Border x:Name="ProblemCard" Classes="card" IsVisible="False" Background="#2A2210" BorderBrush="#7A5A1A" Padding="14" Margin="0,0,0,10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock x:Name="ProblemText" TextWrapping="Wrap" Foreground="#F5C97A" VerticalAlignment="Center" FontSize="12" />
          <Button x:Name="RetryButton" Grid.Column="1" Content="Retry" />
        </Grid>
      </Border>

      <Border x:Name="SetupCard" Classes="card" Padding="14" IsVisible="False" Margin="0,0,0,10">
        <StackPanel Spacing="8">
          <TextBlock Text="SETUP" Classes="label" />
          <TextBox x:Name="SetupText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="110" MaxHeight="200" FontSize="12" />
        </StackPanel>
      </Border>

      <!-- Windows: a program running as administrator was in front, and this app can't see what is typed into it -->
      <Border x:Name="AdminCard" Classes="card" IsVisible="False" Background="#2A2210" BorderBrush="#7A5A1A" Padding="14" Margin="0,0,0,10">
        <StackPanel Spacing="8">
          <TextBlock x:Name="AdminText" TextWrapping="Wrap" Foreground="#F5C97A" FontSize="12" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="AdminRestartButton" Content="Restart as administrator" />
            <Button x:Name="AdminHideButton" Content="Not now" Classes="ghost" />
          </StackPanel>
          <TextBlock x:Name="AdminNote" Classes="muted" FontSize="11" TextWrapping="Wrap" Text="Windows asks first." />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Which keyboard the settings below are for (Windows, once a keyboard has typed) -->
    <Border x:Name="KbCard" Grid.Row="2" Classes="card" Padding="14,10" IsVisible="False" Margin="0,0,0,10">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <TextBlock Text="KEYBOARD" Classes="label" VerticalAlignment="Center" />
          <ComboBox x:Name="KbBox" Grid.Column="1" HorizontalAlignment="Stretch" MinHeight="32" Padding="10,3"
                    ToolTip.Tip="Sensitivity, caught keys and exceptions are for the keyboard chosen here. Keyboards you haven't changed (and mouse buttons) follow All keyboards." />
          <Button x:Name="KbResetButton" Grid.Column="2" Content="Use default" MinHeight="32" Padding="12,3" IsVisible="False" />
        </Grid>
        <Grid x:Name="KbOnRow" ColumnDefinitions="*,Auto" IsVisible="False">
          <TextBlock Text="Filter this keyboard" VerticalAlignment="Center" />
          <ToggleSwitch x:Name="KbOnSwitch" Grid.Column="1" OnContent="" OffContent="" />
        </Grid>
      </StackPanel>
    </Border>

    <TabControl Grid.Row="3" Padding="0,10,0,0">

      <!-- ============ Filter ============ -->
      <TabItem Header="Filter">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,0,12,0">
            <Border Classes="card" Padding="16">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1">
                    <TextBlock Text="Filter keyboard chatter" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="Drops double presses before programs see them" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch x:Name="FilterSwitch" Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="SENSITIVITY" Classes="label" VerticalAlignment="Center" />
                  <TextBlock x:Name="MsText" Grid.Column="1" Foreground="#19F58C" FontWeight="Bold" />
                </Grid>
                <Slider x:Name="MsSlider" Minimum="5" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                        ToolTip.Tip="A press is dropped if the same key was let go less than this long ago. Fast typing leaves about 50 ms, chatter about 10." />
                <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="25–40 ms suits most keyboards." />
              </StackPanel>
            </Border>

            <!-- Windows: mouse buttons, with a delay of their own -->
            <Border x:Name="MouseCard" Classes="card" Padding="16" IsVisible="False">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="1">
                    <TextBlock Text="Filter mouse buttons" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="For a worn switch that double-clicks. Off: the mouse isn't watched." Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch x:Name="MouseSwitch" Grid.Column="1" OnContent="" OffContent="" VerticalAlignment="Center" />
                </Grid>
                <StackPanel x:Name="MousePanel" Spacing="10" IsVisible="False">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="MOUSE DELAY" Classes="label" VerticalAlignment="Center" />
                    <TextBlock x:Name="MouseMsText" Grid.Column="1" Foreground="#19F58C" FontWeight="Bold" />
                  </Grid>
                  <Slider x:Name="MouseSlider" Minimum="5" Maximum="150" TickFrequency="1" IsSnapToTickEnabled="True"
                          ToolTip.Tip="A click is dropped if the same button was let go less than this long ago. One button can get its own delay under Keys → Exceptions (with All keyboards chosen)." />
                  <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="Start at 50 ms; lower it if real double-clicks go missing." />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card" Padding="16">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="TRY IT" Classes="label" VerticalAlignment="Center" />
                  <TextBlock x:Name="BlockedText" Grid.Column="1" Classes="muted" FontSize="11" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox x:Name="TestPad" PlaceholderText="Click here, then Simulate" MinHeight="36" />
                  <Button x:Name="TestButton" Grid.Column="1" Content="Simulate a bounce" />
                </Grid>
                <TextBlock x:Name="TestResult" TextWrapping="Wrap" FontSize="12" Foreground="#C9CFDB" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ Keys ============ -->
      <TabItem Header="Keys">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,0,12,0">
            <Border Classes="card" Padding="16">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="CAUGHT KEYS" Classes="label" VerticalAlignment="Center"
                             ToolTip.Tip="Keys that were blocked, got through looking like chatter, or were re-pressed very quickly since the app started. Each gets a suggested delay from its own data; hover a suggestion to see why." />
                  <Button x:Name="MonitorButton" Grid.Column="1" Content="Chatter monitor" MinHeight="30" Padding="12,3" FontSize="12" />
                </Grid>
                <StackPanel x:Name="CaughtList" Spacing="6" />
              </StackPanel>
            </Border>

            <Border Classes="card" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock Text="EXCEPTIONS" Classes="label" ToolTip.Tip="Give one key its own delay, or 0 to never filter it (for a key you tap fast on purpose)." />
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <ComboBox x:Name="KeyBox" HorizontalAlignment="Stretch" MinHeight="34" Padding="10,4" PlaceholderText="Key…" />
                  <NumericUpDown x:Name="NewMs" Grid.Column="1" Minimum="0" Maximum="250" Value="60" FormatString="0" MinHeight="34" Width="120" />
                  <Button x:Name="AddButton" Grid.Column="2" Content="Add" MinHeight="34" Padding="14,4" />
                </Grid>
                <StackPanel x:Name="RulesList" Spacing="6" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ Options ============ -->
      <TabItem Header="Options">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,0,12,0">
            <Border Classes="card" Padding="16">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Also filter Shift, Ctrl, Alt and Win" VerticalAlignment="Center" />
                  <ToggleSwitch x:Name="ModifiersSwitch" Grid.Column="1" OnContent="" OffContent="" />
                </Grid>
                <Grid x:Name="HoldSafeRow" ColumnDefinitions="*,Auto" IsVisible="False">
                  <StackPanel Spacing="1" VerticalAlignment="Center"
                              ToolTip.Tip="Each release is held back by the key's delay, so a bounce can't let go of a key you're holding. Letting go reaches programs that much later.">
                    <TextBlock Text="Protect held keys" />
                    <TextBlock Text="For games; releases arrive a little later" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock x:Name="HoldSafeMouseNote" IsVisible="False" Classes="muted" FontSize="11" TextWrapping="Wrap"
                               Text="Also keeps held mouse buttons and drags down" />
                  </StackPanel>
                  <ToggleSwitch x:Name="HoldSafeSwitch" Grid.Column="1" OnContent="" OffContent="" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1" VerticalAlignment="Center"
                              ToolTip.Tip="When chatter gets past a key's delay twice, that key's delay is raised just above it, never past the limit. Quick double taps never count.">
                    <TextBlock Text="Auto-adjust delays" />
                    <TextBlock Text="Raise a key's delay when chatter slips past" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch x:Name="AutoSwitch" Grid.Column="1" OnContent="" OffContent="" />
                </Grid>
                <Grid x:Name="AutoLimitRow" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <TextBlock Text="Never go above" VerticalAlignment="Center" Classes="muted" />
                  <NumericUpDown x:Name="AutoMax" Grid.Column="1" Minimum="10" Maximum="100" FormatString="0" Width="120" MinHeight="32" />
                  <TextBlock Grid.Column="2" Text="ms" VerticalAlignment="Center" Classes="muted" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="Hotkey Ctrl + Alt + Shift + F9" />
                    <TextBlock Text="Filtering on/off from anywhere" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <ToggleSwitch x:Name="HotkeySwitch" Grid.Column="1" OnContent="" OffContent="" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="Start when I sign in" />
                    <TextBlock x:Name="AutostartNote" Text="Runs quietly in the tray" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                    <Button x:Name="AutostartAdminButton" Classes="suggest" Content="Start as administrator instead" IsVisible="False"
                            HorizontalAlignment="Left" Margin="0,4,0,0" />
                  </StackPanel>
                  <ToggleSwitch x:Name="AutostartSwitch" Grid.Column="1" OnContent="" OffContent="" />
                </Grid>
              </StackPanel>
            </Border>

            <Border x:Name="PauseCard" Classes="card" Padding="16" IsVisible="False">
              <StackPanel Spacing="8">
                <TextBlock Text="PAUSE WHILE IN FRONT" Classes="label"
                           ToolTip.Tip="Filtering pauses while one of these programs is in front, e.g. a game where you double-tap on purpose. Start the program, then pick it here." />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <ComboBox x:Name="ProgramBox" HorizontalAlignment="Stretch" MinHeight="34" Padding="10,4" PlaceholderText="Running program…" />
                  <Button x:Name="AddProgramButton" Grid.Column="1" Content="Add" MinHeight="34" Padding="14,4" />
                </Grid>
                <StackPanel x:Name="ProgramList" Spacing="4" />
              </StackPanel>
            </Border>

            <Border x:Name="DevicesCard" Classes="card" Padding="16" IsVisible="False">
              <StackPanel Spacing="8">
                <TextBlock Text="KEYBOARDS" Classes="label" />
                <TextBlock Classes="muted" FontSize="11" Text="Untick any keyboard to leave alone." />
                <StackPanel x:Name="DeviceList" Spacing="2" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
